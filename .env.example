# Copy to .env for local use. Never commit real secrets.

# development | test | production
ENV=development

# Local Postgres (docker compose provides this one)
DATABASE_URL=postgresql+psycopg://onrecord:onrecord@localhost:5432/onrecord

# Sign-in. "dev" accepts "Authorization: Bearer dev:<email>" for local testing only;
# it is refused when ENV=production. Production uses "firebase" (Google Identity Platform).
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# AI. Get a key from the Claude Console. Change LLM_MODEL only after running the eval.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Monthly AI token budget per organization
DEFAULT_MONTHLY_TOKEN_BUDGET=5000000

# Comma-separated web origins allowed to call the API (required in production)
ALLOWED_ORIGINS=http://localhost:5173
